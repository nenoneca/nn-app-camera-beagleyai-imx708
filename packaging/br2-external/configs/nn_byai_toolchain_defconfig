# The BeagleY-AI cross toolchain and nothing else: packaging/build-toolchain.sh
# runs `make sdk` on this and the image build uses the result as an external
# toolchain, instead of rebuilding gcc, binutils and glibc from source on every
# clean image build.
#
# The architecture and toolchain lines are the ones nn_beagley_ai_612bt_defconfig
# carried for its internal toolchain; every other toolchain-relevant option is
# a Buildroot default on both sides.  Keep them identical: the image
# defconfig's BR2_TOOLCHAIN_EXTERNAL_* capability flags describe THIS build,
# and Buildroot checks them against the real toolchain at build time.
BR2_aarch64=y
BR2_ARM_FPU_VFPV4=y
BR2_CCACHE=y
BR2_TOOLCHAIN_BUILDROOT=y
BR2_GCC_VERSION_13_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# No target userland: the SDK is the toolchain and its sysroot, nothing more.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
